datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  RECEPTIONIST
  SERVICE
  DOCUMENTS
  PUC
}

enum ReminderType {
  SERVICE
  INSURANCE
  PUC
  WARRANTY
}

enum ReminderChannel {
  SMS
  EMAIL
  WHATSAPP
  IN_APP
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(RECEPTIONIST)
  isActive     Boolean  @default(true) @map("is_active")
  resetTokenHash String? @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  assignedBookings Booking[] @relation("BookingAssignedStaff")

  @@map("users")
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  address   String?
  vehicles  Vehicle[]
  bookings  Booking[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("customers")
}

model Vehicle {
  id                  Int              @id @default(autoincrement())
  customerId          Int              @map("customer_id")
  customer            Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  regNumber           String           @unique @map("reg_number")
  make                String
  model               String
  year                Int?
  purchaseDate        DateTime?        @map("purchase_date")
  insuranceExpiry     DateTime?        @map("insurance_expiry")
  pucExpiry           DateTime?        @map("puc_expiry")
  warrantyExpiry      DateTime?        @map("warranty_expiry")
  serviceIntervalDays Int              @default(180) @map("service_interval_days")
  lastServiceDate     DateTime?        @map("last_service_date")
  nextServiceDate     DateTime?        @map("next_service_date")
  serviceHistory      ServiceHistory[]
  reminders           Reminder[]
  bookings            Booking[]
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@index([regNumber])
  @@index([nextServiceDate])
  @@index([insuranceExpiry])
  @@index([pucExpiry])
  @@index([warrantyExpiry])
  @@map("vehicles")
}

model ServiceHistory {
  id          Int      @id @default(autoincrement())
  vehicleId   Int      @map("vehicle_id")
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceType String   @map("service_type")
  serviceDate DateTime @map("service_date")
  cost        Decimal  @default(0.00) @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("service_history")
}

model Reminder {
  id           Int             @id @default(autoincrement())
  vehicleId    Int             @map("vehicle_id")
  vehicle      Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type         ReminderType
  dueDate      DateTime        @map("due_date")
  leadDays     Int             @default(0) @map("lead_days")
  channel      ReminderChannel
  status       ReminderStatus  @default(PENDING)
  sentAt       DateTime?       @map("sent_at")
  errorMessage String?         @map("error_message")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([vehicleId, type, dueDate, leadDays])
  @@map("reminders")
}

model Booking {
  id           Int           @id @default(autoincrement())
  vehicleId    Int           @map("vehicle_id")
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customerId   Int           @map("customer_id")
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedStaffId Int?       @map("assigned_staff_id")
  assignedStaff User?        @relation("BookingAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  bookingDate  DateTime      @map("booking_date")
  slotStart    String        @map("slot_start")
  slotEnd      String        @map("slot_end")
  contactName  String        @map("contact_name")
  contactPhone String        @map("contact_phone")
  serviceType  String        @default("General service") @map("service_type")
  status       BookingStatus @default(CONFIRMED)
  bookingCode  String        @unique @map("booking_code")
  invoicePhotoUrl String?    @map("invoice_photo_url")
  invoice      Invoice?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([bookingDate])
  @@map("bookings")
}

model Service {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("services")
}

model Invoice {
  id            Int           @id @default(autoincrement())
  bookingId     Int?          @unique @map("booking_id")
  booking       Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  amount        Decimal       @default(0.00) @db.Decimal(10, 2)
  tax           Decimal       @default(0.00) @db.Decimal(10, 2)
  total         Decimal       @default(0.00) @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod PaymentMethod? @map("payment_method")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("invoices")
}

model SlotConfig {
  id                  Int      @id @default(autoincrement())
  workingHoursStart   String   @default("09:00") @map("working_hours_start")
  workingHoursEnd     String   @default("18:00") @map("working_hours_end")
  slotDurationMinutes Int      @default(60) @map("slot_duration_minutes")
  maxBookingsPerSlot  Int      @default(4) @map("max_bookings_per_slot")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("slot_config")
}
